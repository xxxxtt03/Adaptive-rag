    {
      "name": "2. 核心问答与业务工具 (Core Workflows)",
      "item": [
        {
          "name": "Turn 1: Fast-Path Greeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"你好，请问你是谁？\",\n  \"session_id\": \"{{sessionId}}\",\n  \"user_id\": \"{{userId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Classified as Greeting/Chitchat', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.intent).to.be.oneOf(['greeting', 'chitchat']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
