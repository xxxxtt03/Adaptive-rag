              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.pending_action) {",
                  "    pm.collectionVariables.set('actionId', json.pending_action.action_id);",
                  "    pm.test('Action proposal created', function () {",
                  "        pm.expect(json.pending_action.tool_name).to.eql('cancel_order');",
                  "    });",
                  "}"
                ],
